Program {
  Import(sdk="ailang" path="std/core.aos")
  Import(package="std-app" path="src/app/app.aos")
  Import(package="std-app" path="src/app/event.aos")
  Import(package="std-app" path="src/app/global.aos")
  Import(package="std-app" path="src/app/next.aos")
  Import(path="app_mode.aos")
  Import(path="events.aos")
  Import(path="menu.aos")

  Export(name=aivectraApp)
  Export(name=aivectraAppName)
  Export(name=aivectraAppSpec)
  Export(name=aivectraAppInit)
  Export(name=aivectraAppUpdate)
  Export(name=aivectraAppRender)
  Export(name=aivectraAppWindowWidth)
  Export(name=aivectraAppWindowHeight)
  Export(name=aivectraAppMenuBar)
  Export(name=aivectraAppWithMenuBar)
  Export(name=aivectraAppSettingsRender)
  Export(name=aivectraAppSettingsWindowWidth)
  Export(name=aivectraAppSettingsWindowHeight)
  Export(name=aivectraAppWithSettingsWindow)
  Export(name=aivectraStartEvent)
  Export(name=aivectraRunContext)
  Export(name=aivectraRunMode)
  Export(name=aivectraRunState)
  Export(name=aivectraRunShouldSnapshot)
  Export(name=aivectraRunWindow)
  Export(name=aivectraResizeEvent)
  Export(name=aivectraFrameAppEvent)
  Export(name=aivectraFrameAppEventForWindow)
  Export(name=aivectraRun)
  Export(name=aivectraMenuItem)
  Export(name=aivectraMenuSeparator)
  Export(name=aivectraMenuBarItem)
  Export(name=aivectraMenuBar)
  Export(name=aivectraDefaultApplicationMenu)
  Export(name=aivectraDefaultMenuBar)
  Export(name=aivectraMenuBarItemTitle)
  Export(name=aivectraMenuItemCommand)
  Export(name=aivectraMenuItemRole)

  Let(name=aivectraApp) {
    Fn(params=name,initName,updateName,renderName) {
      Block {
        Let(name=spec) {
          Call(target=globalApp) {
            Var(name=name)
            Call(target=profileGui) { Lit(value=0) }
            Var(name=initName)
            Var(name=updateName)
          }
        }
        Return {
          Map {
            Field(key="kind") { Lit(value="AiVectraApp") }
            Field(key="app") { Var(name=spec) }
            Field(key="render") { Var(name=renderName) }
            Field(key="windowWidth") { Lit(value=960) }
            Field(key="windowHeight") { Lit(value=640) }
            Field(key="menuBar") { Call(target=aivectraDefaultMenuBar) { Var(name=name) } }
            Field(key="settingsRender") { Lit(value="") }
            Field(key="settingsWindowWidth") { Lit(value=420) }
            Field(key="settingsWindowHeight") { Lit(value=300) }
          }
        }
      }
    }
  }

  Let(name=aivectraAppSpec) {
    Fn(params=app) {
      Block {
        Return {
          Call(target=mapGetNodeOr) {
            Var(name=app)
            Lit(value="app")
            Map { }
          }
        }
      }
    }
  }

  Let(name=aivectraAppName) {
    Fn(params=app) {
      Block {
        Return {
          Call(target=globalAppName) {
            Call(target=aivectraAppSpec) { Var(name=app) }
          }
        }
      }
    }
  }

  Let(name=aivectraAppInit) {
    Fn(params=app) {
      Block {
        Return {
          Call(target=globalAppInit) {
            Call(target=aivectraAppSpec) { Var(name=app) }
          }
        }
      }
    }
  }

  Let(name=aivectraAppUpdate) {
    Fn(params=app) {
      Block {
        Return {
          Call(target=globalAppUpdate) {
            Call(target=aivectraAppSpec) { Var(name=app) }
          }
        }
      }
    }
  }

  Let(name=aivectraAppRender) {
    Fn(params=app) {
      Block {
        Return {
          Call(target=mapGetStringOr) {
            Var(name=app)
            Lit(value="render")
            Lit(value="")
          }
        }
      }
    }
  }

  Let(name=aivectraAppWindowWidth) {
    Fn(params=app) {
      Block {
        Return { Call(target=mapGetIntOr) { Var(name=app) Lit(value="windowWidth") Lit(value=960) } }
      }
    }
  }

  Let(name=aivectraAppWindowHeight) {
    Fn(params=app) {
      Block {
        Return { Call(target=mapGetIntOr) { Var(name=app) Lit(value="windowHeight") Lit(value=640) } }
      }
    }
  }

  Let(name=aivectraAppMenuBar) {
    Fn(params=app) {
      Block {
        Return {
          Call(target=mapGetNodeOr) {
            Var(name=app)
            Lit(value="menuBar")
            Call(target=aivectraDefaultMenuBar) { Call(target=aivectraAppName) { Var(name=app) } }
          }
        }
      }
    }
  }

  Let(name=aivectraAppWithMenuBar) {
    Fn(params=app,menuBar) {
      Block {
        Return { Call(target=mapSet) { Var(name=app) Lit(value="menuBar") Var(name=menuBar) } }
      }
    }
  }

  Let(name=aivectraAppSettingsRender) {
    Fn(params=app) {
      Block {
        Return { Call(target=mapGetStringOr) { Var(name=app) Lit(value="settingsRender") Lit(value="") } }
      }
    }
  }

  Let(name=aivectraAppSettingsWindowWidth) {
    Fn(params=app) {
      Block {
        Return { Call(target=mapGetIntOr) { Var(name=app) Lit(value="settingsWindowWidth") Lit(value=420) } }
      }
    }
  }

  Let(name=aivectraAppSettingsWindowHeight) {
    Fn(params=app) {
      Block {
        Return { Call(target=mapGetIntOr) { Var(name=app) Lit(value="settingsWindowHeight") Lit(value=300) } }
      }
    }
  }

  Let(name=aivectraAppWithSettingsWindow) {
    Fn(params=app,settingsRenderName,width,height) {
      Block {
        Return {
          Call(target=mapSet) {
            Call(target=mapSet) {
              Call(target=mapSet) {
                Var(name=app)
                Lit(value="settingsRender")
                Var(name=settingsRenderName)
              }
              Lit(value="settingsWindowWidth")
              Var(name=width)
            }
            Lit(value="settingsWindowHeight")
            Var(name=height)
          }
        }
      }
    }
  }

  Let(name=aivectraStartEvent) {
    Fn(params=args) {
      Block {
        Return { Call(target=startEvent) { Var(name=args) } }
      }
    }
  }

  Let(name=aivectraRunContext) {
    Fn(params=app,args,nextValue) {
      Block {
        Return {
          Map {
            Field(key="kind") { Lit(value="AiVectraRunContext") }
            Field(key="app") { Var(name=app) }
            Field(key="mode") { Call(target=guiModeFromArgs) { Var(name=args) } }
            Field(key="state") { Call(target=nextState) { Var(name=nextValue) } }
          }
        }
      }
    }
  }

  Let(name=aivectraRunMode) {
    Fn(params=ctx) {
      Block {
        Return {
          Call(target=mapGetStringOr) {
            Var(name=ctx)
            Lit(value="mode")
            Lit(value="")
          }
        }
      }
    }
  }

  Let(name=aivectraRunState) {
    Fn(params=ctx) {
      Block {
        Return {
          Call(target=mapGetNodeOr) {
            Var(name=ctx)
            Lit(value="state")
            Map { }
          }
        }
      }
    }
  }

  Let(name=aivectraRunShouldSnapshot) {
    Fn(params=ctx) {
      Block {
        Return {
          Eq {
            Call(target=aivectraRunMode) { Var(name=ctx) }
            Lit(value="snapshot")
          }
        }
      }
    }
  }

  Let(name=aivectraRunWindow) {
    Fn(params=ctx) {
      Block {
        Return {
          Call(target=sys.ui.createWindow) {
            Call(target=aivectraAppName) {
              Call(target=mapGetNodeOr) {
                Var(name=ctx)
                Lit(value="app")
                Map { }
              }
            }
            Call(target=aivectraAppWindowWidth) { Call(target=mapGetNodeOr) { Var(name=ctx) Lit(value="app") Map { } } }
            Call(target=aivectraAppWindowHeight) { Call(target=mapGetNodeOr) { Var(name=ctx) Lit(value="app") Map { } } }
          }
        }
      }
    }
  }

  Let(name=aivectraResizeEvent) {
    Fn(params=width,height) {
      Block {
        Return {
          Map {
            Field(key="type") { Lit(value="resize") }
            Field(key="width") { Var(name=width) }
            Field(key="height") { Var(name=height) }
            Field(key="platform") { Call(target=sys.runtime.platform) { } }
          }
        }
      }
    }
  }

  Let(name=aivectraFrameAppEvent) {
    Fn(params=eventNode,width,height) {
      Block { Return { Call(target=aivectraFrameAppEventForWindow) { Var(name=eventNode) Var(name=width) Var(name=height) Lit(value="") } } }
    }
  }

  Let(name=aivectraFrameAppEventForWindow) {
    Fn(params=eventNode,width,height,windowName) {
      Block {
        If {
          Call(target=eventIsNone) { Var(name=eventNode) }
          Block { Return { Call(target=noneEvent) { Lit(value=0) } } }
          Block {
            Return {
              Call(target=uiEvent) {
                Map {
                  Field(key="type") { Call(target=eventTypeOf) { Var(name=eventNode) } }
                  Field(key="x") { Call(target=eventXOf) { Var(name=eventNode) } }
                  Field(key="y") { Call(target=eventYOf) { Var(name=eventNode) } }
                  Field(key="dx") { Call(target=eventDeltaXOf) { Var(name=eventNode) } }
                  Field(key="dy") { Call(target=eventDeltaYOf) { Var(name=eventNode) } }
                  Field(key="key") { Call(target=eventKeyOf) { Var(name=eventNode) } }
                  Field(key="text") { Call(target=eventTextOf) { Var(name=eventNode) } }
                  Field(key="target") { Call(target=eventTargetIdOf) { Var(name=eventNode) } }
                  Field(key="window") { Var(name=windowName) }
                  Field(key="platform") { Call(target=sys.runtime.platform) { } }
                  Field(key="width") { Var(name=width) }
                  Field(key="height") { Var(name=height) }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=aivectraNextHasCommandType) {
    Fn(params=nextValue,commandTypeName) {
      Block {
        Let(name=commands) { Call(target=nextCommands) { Var(name=nextValue) } }
        If {
          Eq { Call(target=commandListCount) { Var(name=commands) } Lit(value=0) }
          Block { Return { Lit(value=false) } }
          Block {
            Let(name=command) {
              Call(target=commandAtOr) {
                Var(name=commands)
                Lit(value=0)
                Map { }
              }
            }
            Return {
              Eq {
                Call(target=mapGetStringOr) { Var(name=command) Lit(value="type") Lit(value="") }
                Var(name=commandTypeName)
              }
            }
          }
        }
      }
    }
  }

  Let(name=aivectraRun) {
    Fn(params=app,args) {
      Block {
        Let(name=initName) { Call(target=aivectraAppInit) { Var(name=app) } }
        Let(name=updateName) { Call(target=aivectraAppUpdate) { Var(name=app) } }
        Let(name=renderName) { Call(target=aivectraAppRender) { Var(name=app) } }
        Let(name=settingsRenderName) { Call(target=aivectraAppSettingsRender) { Var(name=app) } }
        Let(name=initialState) {
          CallDynamic(candidates="init") {
            Var(name=initName)
            Var(name=args)
          }
        }
        Let(name=firstStep) {
          CallDynamic(candidates="update") {
            Var(name=updateName)
            Var(name=initialState)
            Call(target=aivectraStartEvent) { Var(name=args) }
          }
        }
        Let(name=run) {
          Call(target=aivectraRunContext) {
            Var(name=app)
            Var(name=args)
            Var(name=firstStep)
          }
        }
        If {
          Call(target=aivectraRunShouldSnapshot) { Var(name=run) }
          Block {
            Let(name=handle) { Call(target=aivectraRunWindow) { Var(name=run) } }
            CallDynamic(candidates="render") {
              Var(name=renderName)
              Var(name=handle)
              Call(target=aivectraRunState) { Var(name=run) }
            }
            Return { Lit(value=0) }
          }
          Block { Lit(value=0) }
        }
        Let(name=handle) { Call(target=aivectraRunWindow) { Var(name=run) } }
        Let(name=currentState) { Call(target=aivectraRunState) { Var(name=run) } }
        Let(name=settingsHandle) { Lit(value=0) }
        Let(name=initialSizeNode) { Call(target=sys.ui.getWindowSize) { Var(name=handle) } }
        Let(name=initialFrameWidth) { Call(target=attrInt) { Var(name=initialSizeNode) Lit(value="width") Lit(value=0) } }
        Let(name=initialFrameHeight) { Call(target=attrInt) { Var(name=initialSizeNode) Lit(value="height") Lit(value=0) } }
        Let(name=initialResizeStep) {
          CallDynamic(candidates="update") {
            Var(name=updateName)
            Var(name=currentState)
            Call(target=uiEvent) { Call(target=aivectraResizeEvent) { Var(name=initialFrameWidth) Var(name=initialFrameHeight) } }
          }
        }
        Let(name=currentState) { Call(target=nextState) { Var(name=initialResizeStep) } }
        CallDynamic(candidates="render") {
          Var(name=renderName)
          Var(name=handle)
          Var(name=currentState)
        }
        Loop {
          Block {
            Let(name=sizeNode) { Call(target=sys.ui.getWindowSize) { Var(name=handle) } }
            Let(name=frameWidth) { Call(target=attrInt) { Var(name=sizeNode) Lit(value="width") Lit(value=0) } }
            Let(name=frameHeight) { Call(target=attrInt) { Var(name=sizeNode) Lit(value="height") Lit(value=0) } }
            Let(name=evt) { Call(target=frameEvent) { Var(name=handle) } }
            If {
              Eq { Call(target=eventTypeOf) { Var(name=evt) } Lit(value="command") }
              Block {
                If {
                  Eq { Call(target=eventKeyOf) { Var(name=evt) } Lit(value="settings") }
                  Block {
                    If {
                      Eq { Var(name=settingsHandle) Lit(value=0) }
                      Block {
                        If {
                          Eq { Var(name=settingsRenderName) Lit(value="") }
                          Block { Lit(value=0) }
                          Block {
                            Let(name=settingsHandle) {
                              Call(target=sys.ui.createWindow) {
                                StrConcat {
                                  Call(target=aivectraAppName) { Var(name=app) }
                                  Lit(value=" Settings")
                                }
                                Call(target=aivectraAppSettingsWindowWidth) { Var(name=app) }
                                Call(target=aivectraAppSettingsWindowHeight) { Var(name=app) }
                              }
                            }
                            Lit(value=0)
                          }
                        }
                      }
                      Block { Lit(value=0) }
                    }
                  }
                  Block { Lit(value=0) }
                }
              }
              Block { Lit(value=0) }
            }
            Let(name=step) {
              CallDynamic(candidates="update") {
                Var(name=updateName)
                Var(name=currentState)
                Call(target=aivectraFrameAppEventForWindow) { Var(name=evt) Var(name=frameWidth) Var(name=frameHeight) Lit(value="main") }
              }
            }
            If {
              Eq { Var(name=settingsHandle) Lit(value=0) }
              Block { Lit(value=0) }
              Block {
                If {
                  Call(target=aivectraNextHasCommandType) { Var(name=step) Lit(value="CloseSettings") }
                  Block {
                    Call(target=sys.ui.closeWindow) { Var(name=settingsHandle) }
                    Let(name=settingsHandle) { Lit(value=0) }
                    Lit(value=0)
                  }
                  Block { Lit(value=0) }
                }
              }
            }
            Let(name=nextMainState) { Call(target=nextState) { Var(name=step) } }
            If {
              Eq { Var(name=nextMainState) Var(name=currentState) }
              Block { Lit(value=0) }
              Block {
                CallDynamic(candidates="render") {
                  Var(name=renderName)
                  Var(name=handle)
                  Var(name=nextMainState)
                }
                Lit(value=0)
              }
            }
            Let(name=currentState) { Var(name=nextMainState) }
            If {
              Eq { Var(name=settingsHandle) Lit(value=0) }
              Block { Lit(value=0) }
              Block {
                CallDynamic(candidates="settingsRender") {
                  Var(name=settingsRenderName)
                  Var(name=settingsHandle)
                  Var(name=currentState)
                }
                Let(name=settingsSizeNode) { Call(target=sys.ui.getWindowSize) { Var(name=settingsHandle) } }
                Let(name=settingsFrameWidth) { Call(target=attrInt) { Var(name=settingsSizeNode) Lit(value="width") Lit(value=0) } }
                Let(name=settingsFrameHeight) { Call(target=attrInt) { Var(name=settingsSizeNode) Lit(value="height") Lit(value=0) } }
                Let(name=settingsEvt) { Call(target=frameEvent) { Var(name=settingsHandle) } }
                Let(name=settingsStep) {
                  CallDynamic(candidates="update") {
                    Var(name=updateName)
                    Var(name=currentState)
                    Call(target=aivectraFrameAppEventForWindow) { Var(name=settingsEvt) Var(name=settingsFrameWidth) Var(name=settingsFrameHeight) Lit(value="settings") }
                  }
                }
                If {
                  Call(target=aivectraNextHasCommandType) { Var(name=settingsStep) Lit(value="CloseSettings") }
                  Block {
                    Call(target=sys.ui.closeWindow) { Var(name=settingsHandle) }
                    Let(name=settingsHandle) { Lit(value=0) }
                    Lit(value=0)
                  }
                  Block { Lit(value=0) }
                }
                Let(name=currentState) { Call(target=nextState) { Var(name=settingsStep) } }
                If {
                  Call(target=eventIsClosed) { Var(name=settingsEvt) }
                  Block { Let(name=settingsHandle) { Lit(value=0) } }
                  Block { Lit(value=0) }
                }
                Lit(value=0)
              }
            }
            If {
              Call(target=eventIsClosed) { Var(name=evt) }
              Block { Break { } }
              Block { Lit(value=0) }
            }
            Continue { }
          }
        }
        Return { Lit(value=0) }
      }
    }
  }
}
