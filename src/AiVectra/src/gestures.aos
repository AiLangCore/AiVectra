Program {
  Import(sdk="ailang" path="std/math.aos")
  Import(package="std-ui-input" path="src/ui/input.aos")

  Export(name=gestureIsDragLike)
  Export(name=gestureIsSwipeLike)
  Export(name=gestureSwipeAxis)

  Let(name=gestureIsDragLike) {
    Fn(params=event) {
      Block {
        Let(name=eventType) { Call(target=inputEventType) { Var(name=event) } }
        If {
          Eq { Var(name=eventType) Lit(value="drag") }
          Block { Return { Lit(value=true) } }
          Block {
            If {
              Eq { Var(name=eventType) Lit(value="pointerdrag") }
              Block { Return { Lit(value=true) } }
              Block {
                If {
                  Eq { Var(name=eventType) Lit(value="mouse_drag") }
                  Block { Return { Lit(value=true) } }
                  Block { Return { Lit(value=false) } }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=gestureSwipeAxis) {
    Fn(params=event) {
      Block {
        Let(name=dx) { Call(target=inputEventDeltaX) { Var(name=event) } }
        Let(name=dy) { Call(target=inputEventDeltaY) { Var(name=event) } }
        Let(name=adx) { Call(target=abs) { Var(name=dx) } }
        Let(name=ady) { Call(target=abs) { Var(name=dy) } }
        If {
          Call(target=lt) { Var(name=ady) Var(name=adx) }
          Block { Return { Lit(value="x") } }
          Block { Return { Lit(value="y") } }
        }
      }
    }
  }

  Let(name=gestureIsSwipeLike) {
    Fn(params=event,minDistance) {
      Block {
        Let(name=dx) { Call(target=inputEventDeltaX) { Var(name=event) } }
        Let(name=dy) { Call(target=inputEventDeltaY) { Var(name=event) } }
        Let(name=adx) { Call(target=abs) { Var(name=dx) } }
        Let(name=ady) { Call(target=abs) { Var(name=dy) } }
        If {
          Call(target=lt) { Var(name=ady) Var(name=adx) }
          Block { Return { Call(target=gte) { Var(name=adx) Var(name=minDistance) } } }
          Block { Return { Call(target=gte) { Var(name=ady) Var(name=minDistance) } } }
        }
      }
    }
  }
}
