Program {
  Import(path="math.aos")
  Import(path="events.aos")
  Import(path="text_input.aos")
  Import(path="geometry.aos")
  Import(path="debug.aos")
  Import(path="rendering.aos")
  Import(path="layout.aos")
  Import(path="app_mode.aos")
  Import(path="primitives.aos")
  Import(path="gestures.aos")

  Let(name=version) {
    Fn(params=_) {
      Block { Return { Lit(value="0.0.1") } }
    }
  }

  Let(name=library) {
    Fn(params=_) {
      Block { Return { Lit(value="AiVectra") } }
    }
  }
  Let(name=window) {
    Fn(params=title) {
      Block {
        Return {
          Call(target=sys.ui.createWindow) { Var(name=title) Lit(value=640) Lit(value=360) }
        }
      }
    }
  }

  Let(name=guiBuild) {
    Fn(params=title,width,height) {
      Block {
        Return { Call(target=sys.ui.createWindow) { Var(name=title) Var(name=width) Var(name=height) } }
      }
    }
  }

  Let(name=guiRun) {
    Fn(params=windowHandle,model) {
      Block {
        Return { Call(target=guiLoop) { Var(name=windowHandle) Var(name=model) } }
      }
    }
  }

  Let(name=guiLoop) {
    Fn(params=windowHandle,model) {
      Block {
        Let(name=currentModel) { Var(name=model) }
        Loop {
          Block {
            Call(target=appRender) { Var(name=windowHandle) Var(name=currentModel) }
            Call(target=sys.ui.waitFrame) { Var(name=windowHandle) }
            Let(name=evt) { Call(target=sys.ui.pollEvent) { Var(name=windowHandle) } }
            If {
              Eq { AttrCount { Var(name=evt) } Lit(value=0) }
              Block { Continue { } }
              Block { Lit(value=0) }
            }
            Let(name=eventType) { Call(target=attrString) { Var(name=evt) Lit(value="type") Lit(value=0) } }
            Let(name=eventKey) { Call(target=attrString) { Var(name=evt) Lit(value="key") Lit(value=0) } }
            Let(name=eventText) { Call(target=attrString) { Var(name=evt) Lit(value="text") Lit(value=0) } }
            Let(name=eventX) { Call(target=attrInt) { Var(name=evt) Lit(value="x") Lit(value=0) } }
            Let(name=eventY) { Call(target=attrInt) { Var(name=evt) Lit(value="y") Lit(value=0) } }
            If {
              Eq { Var(name=eventType) Lit(value="closed") }
              Block { Break { } }
              Block { Lit(value=0) }
            }
            Let(name=nextModel) {
              Call(target=appUpdate) {
                Var(name=currentModel)
                Var(name=eventType)
                Var(name=eventKey)
                Var(name=eventText)
                Var(name=eventX)
                Var(name=eventY)
              }
            }
            Let(name=currentModel) { Var(name=nextModel) }
            Continue { }
          }
        }
        Return { Var(name=currentModel) }
      }
    }
  }

  Let(name=helloWindow) {
    Fn(params=_) {
      Block {
        Return { Call(target=helloNamedWindow) { Lit(value="World") } }
      }
    }
  }

  Let(name=helloNamedWindow) {
    Fn(params=name) {
      Block {
        Let(name=handle) { Call(target=window) { Lit(value="AiVectra Hello") } }
        Let(name=greeting) {
          StrConcat {
            Lit(value="Hello ")
            StrConcat { ToString { Var(name=name) } Lit(value="!") }
          }
        }
        Call(target=debugEmitSceneNode) {
          Lit(value=1)
          Lit(value=1)
          Lit(value="hello_panel")
          Lit(value="root")
          Lit(value="Rect")
          Lit(value="#1e293b")
          Lit(value="")
          Lit(value=0)
          Lit(value="")
          Lit(value="")
          Lit(value=0)
          Lit(value=20)
          Lit(value=20)
          Lit(value=600)
          Lit(value=320)
          Lit(value="matrix(1,0,0,1,0,0)")
        }
        Call(target=debugEmitSceneNode) {
          Lit(value=1)
          Lit(value=2)
          Lit(value="hello_text")
          Lit(value="root")
          Lit(value="Text")
          Lit(value="#ffffff")
          Lit(value="")
          Lit(value=0)
          Var(name=greeting)
          Lit(value="")
          Lit(value=28)
          Lit(value=208)
          Lit(value=180)
          Lit(value=0)
          Lit(value=0)
          Lit(value="matrix(1,0,0,1,0,0)")
        }
        Call(target=waitForCloseHello) { Var(name=handle) Var(name=greeting) }
        Return { Var(name=handle) }
      }
    }
  }

  Let(name=waitForCloseHello) {
    Fn(params=windowHandle,greeting) {
      Block {
        Loop {
          Block {
            Call(target=drawHelloFrame) { Var(name=windowHandle) Var(name=greeting) }
            Call(target=sys.ui.waitFrame) { Var(name=windowHandle) }
            Let(name=evt) { Call(target=sys.ui.pollEvent) { Var(name=windowHandle) } }
            If {
              Eq { AttrCount { Var(name=evt) } Lit(value=0) }
              Block { Continue { } }
              Block { Lit(value=0) }
            }
            If {
              Eq {
                Call(target=attrString) { Var(name=evt) Lit(value="type") Lit(value=0) }
                Lit(value="closed")
              }
              Block { Break { } }
              Block { Continue { } }
            }
          }
        }
        Return { Lit(value=0) }
      }
    }
  }

  Let(name=drawHelloFrame) {
    Fn(params=windowHandle,greeting) {
      Block {
        Call(target=sys.ui.beginFrame) { Var(name=windowHandle) }
        Call(target=rect) { Var(name=windowHandle) }
        Call(target=label) { Var(name=windowHandle) Var(name=greeting) }
        Call(target=sys.ui.endFrame) { Var(name=windowHandle) }
        Call(target=sys.ui.present) { Var(name=windowHandle) }
        Return { Lit(value=0) }
      }
    }
  }

  Let(name=waitForClose) {
    Fn(params=windowHandle) {
      Block {
        Loop {
          Block {
            Call(target=sys.ui.waitFrame) { Var(name=windowHandle) }
            Let(name=evt) { Call(target=sys.ui.pollEvent) { Var(name=windowHandle) } }
            If {
              Eq { AttrCount { Var(name=evt) } Lit(value=0) }
              Block { Continue { } }
              Block { Lit(value=0) }
            }
            If {
              Eq {
                Call(target=attrString) { Var(name=evt) Lit(value="type") Lit(value=0) }
                Lit(value="closed")
              }
              Block { Break { } }
              Block { Continue { } }
            }
          }
        }
        Return { Lit(value=0) }
      }
    }
  }





  Export(name=library)
  Export(name=version)
  Export(name=rect)
  Export(name=text)
  Export(name=label)
  Export(name=window)
  Export(name=attrString)
  Export(name=attrInt)
  Export(name=uiWidth)
  Export(name=uiHeight)
  Export(name=drawPanel)
  Export(name=blurBandColor)
  Export(name=drawGaussianBlurRect)
  Export(name=gradientColor3)
  Export(name=drawLinearGradientRect)
  Export(name=drawRectTransform)
  Export(name=drawEllipseTransform)
  Export(name=drawPathTransform)
  Export(name=drawTextTransform)
  Export(name=interactiveFillForState)
  Export(name=interactiveVectorState)
  Export(name=pointInRect)
  Export(name=pointInEllipse)
  Export(name=pointInPathBounds)
  Export(name=stabilizeSize)
  Export(name=buttonX)
  Export(name=buttonY)
  Export(name=inputWidth)
  Export(name=hintY)
  Export(name=statusY)
  Export(name=removeLastChar)
  Export(name=textInsertAt)
  Export(name=textDeleteAt)
  Export(name=caretClamp)
  Export(name=caretLeft)
  Export(name=caretRight)
  Export(name=caretPixelOffset)
  Export(name=keyToText)
  Export(name=intLt)
  Export(name=intGte)
  Export(name=intLte)
  Export(name=halfFloor)
  Export(name=mul)
  Export(name=sub)
  Export(name=textLen)
  Export(name=divFloor)
  Export(name=fitTextTail)
  Export(name=visibleTextTail)
  Export(name=mapGetString)
  Export(name=keyTextMap)
  Export(name=frameEvent)
  Export(name=eventTypeOf)
  Export(name=eventKeyOf)
  Export(name=eventTextOf)
  Export(name=eventXOf)
  Export(name=eventYOf)
  Export(name=eventIsNone)
  Export(name=eventIsClosed)
  Export(name=gestureIsDragLike)
  Export(name=gestureIsSwipeLike)
  Export(name=gestureSwipeAxis)
  Export(name=debugSizeLine)
  Export(name=debugEventLine)
  Export(name=controlKeyName)
  Export(name=debugInputToken)
  Export(name=debugLayoutLine)
  Export(name=debugEmitEvent)
  Export(name=debugEmitUi)
  Export(name=debugEmitSceneNode)
  Export(name=debugEmitEventIf)
  Export(name=debugEmitUiIf)
  Export(name=debugEmitSceneNodeIf)
  Export(name=debugModeLive)
  Export(name=guiModeFromArgs)
  Export(name=guiBuild)
  Export(name=guiRun)
  Export(name=guiLoop)
  Export(name=layoutSignature)
}
