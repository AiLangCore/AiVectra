Program {
  Import(sdk="ailang" path="std/math.aos")

  Export(name=intLt)
  Export(name=intGt)
  Export(name=intGte)
  Export(name=intLte)
  Export(name=resolveSize)
  Export(name=stabilizeSize)
  Export(name=halfFloor)
  Export(name=divFloor)
  Export(name=subAbs)
  Export(name=mul)
  Export(name=sub)
  Export(name=gt)
  Export(name=eq)
  Export(name=neq)
  Export(name=min)
  Export(name=max)
  Export(name=clamp)

  Let(name=intLt) {
    Fn(params=a,b) {
      Block {
        Return { Call(target=lt) { Var(name=a) Var(name=b) } }
      }
    }
  }

  Let(name=intGt) {
    Fn(params=a,b) {
      Block {
        Return { Call(target=gt) { Var(name=a) Var(name=b) } }
      }
    }
  }

  Let(name=intGte) {
    Fn(params=a,b) {
      Block {
        Return { Call(target=gte) { Var(name=a) Var(name=b) } }
      }
    }
  }

  Let(name=intLte) {
    Fn(params=a,b) {
      Block {
        Return { Call(target=lte) { Var(name=a) Var(name=b) } }
      }
    }
  }

  Let(name=resolveSize) {
    Fn(params=raw,current,defaultValue) {
      Block {
        If {
          Call(target=intLt) { Var(name=raw) Lit(value=1) }
          Block {
            If {
              Call(target=intLt) { Var(name=current) Lit(value=1) }
              Block { Return { Var(name=defaultValue) } }
              Block { Return { Var(name=current) } }
            }
          }
          Block { Return { Var(name=raw) } }
        }
      }
    }
  }

  Let(name=stabilizeSize) {
    Fn(params=raw,current,defaultValue) {
      Block {
        If {
          Call(target=intLt) { Var(name=raw) Lit(value=1) }
          Block {
            If {
              Call(target=intLt) { Var(name=current) Lit(value=1) }
              Block { Return { Var(name=defaultValue) } }
              Block { Return { Var(name=current) } }
            }
          }
          Block {
            If {
              Call(target=intLt) { Var(name=current) Lit(value=1) }
              Block { Return { Var(name=raw) } }
              Block {
                If {
                  Eq { Var(name=raw) Var(name=current) }
                  Block { Return { Var(name=current) } }
                  Block {
                    If {
                      Eq { Var(name=raw) Add { Var(name=current) Lit(value=1) } }
                      Block { Return { Var(name=current) } }
                      Block {
                        If {
                          Eq { Var(name=raw) Add { Var(name=current) Lit(value=-1) } }
                          Block { Return { Var(name=current) } }
                          Block {
                            If {
                              Eq { Var(name=raw) Add { Var(name=current) Lit(value=2) } }
                              Block { Return { Var(name=current) } }
                              Block {
                                If {
                                  Eq { Var(name=raw) Add { Var(name=current) Lit(value=-2) } }
                                  Block { Return { Var(name=current) } }
                                  Block {
                                    If {
                                      Eq { Var(name=raw) Add { Var(name=current) Var(name=current) } }
                                      Block { Return { Var(name=current) } }
                                      Block {
                                        If {
                                          Eq { Var(name=current) Add { Var(name=raw) Var(name=raw) } }
                                          Block { Return { Var(name=current) } }
                                          Block { Return { Var(name=raw) } }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
