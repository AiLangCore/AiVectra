Program {
  Import(sdk="ailang" path="std/core.aos")
  Import(path="text_input.aos")

  Export(name=attrString)
  Export(name=attrInt)
  Export(name=frameEvent)
  Export(name=eventTypeOf)
  Export(name=eventKeyOf)
  Export(name=eventTextOf)
  Export(name=eventXOf)
  Export(name=eventYOf)
  Export(name=eventWidthOf)
  Export(name=eventHeightOf)
  Export(name=eventIsKeyboardLike)
  Export(name=eventInputText)
  Export(name=eventControlKey)
  Export(name=eventIsNone)
  Export(name=eventIsClosed)

  Let(name=attrString) {
    Fn(params=node,key,index) {
      Block {
        If {
          Eq { Var(name=index) AttrCount { Var(name=node) } }
          Block {
            If {
              Eq { AttrCount { Var(name=node) } Lit(value=0) }
              Block { Return { Call(target=mapGetStringOr) { Var(name=node) Var(name=key) Lit(value="") } } }
              Block { Return { Lit(value="") } }
            }
          }
          Block {
            If {
              Eq { AttrKey { Var(name=node) Var(name=index) } Var(name=key) }
              Block { Return { AttrValueString { Var(name=node) Var(name=index) } } }
              Block {
                Return {
                  Call(target=attrString) {
                    Var(name=node)
                    Var(name=key)
                    Add { Var(name=index) Lit(value=1) }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=attrInt) {
    Fn(params=node,key,index) {
      Block {
        If {
          Eq { Var(name=index) AttrCount { Var(name=node) } }
          Block {
            If {
              Eq { AttrCount { Var(name=node) } Lit(value=0) }
              Block { Return { Call(target=mapGetIntOr) { Var(name=node) Var(name=key) Lit(value=-1) } } }
              Block { Return { Lit(value=-1) } }
            }
          }
          Block {
            If {
              Eq { AttrKey { Var(name=node) Var(name=index) } Var(name=key) }
              Block { Return { AttrValueInt { Var(name=node) Var(name=index) } } }
              Block {
                Return {
                  Call(target=attrInt) {
                    Var(name=node)
                    Var(name=key)
                    Add { Var(name=index) Lit(value=1) }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=frameEvent) {
    Fn(params=windowHandle) {
      Block {
        Call(target=sys.ui.waitFrame) { Var(name=windowHandle) }
        Return { Call(target=sys.ui.pollEvent) { Var(name=windowHandle) } }
      }
    }
  }

  Let(name=eventTypeOf) {
    Fn(params=eventNode) {
      Block {
        If {
          Eq { Add { AttrCount { Var(name=eventNode) } ChildCount { Var(name=eventNode) } } Lit(value=0) }
          Block { Return { Lit(value="none") } }
          Block { Return { Call(target=attrString) { Var(name=eventNode) Lit(value="type") Lit(value=0) } } }
        }
      }
    }
  }

  Let(name=eventKeyOf) {
    Fn(params=eventNode) {
      Block { Return { Call(target=attrString) { Var(name=eventNode) Lit(value="key") Lit(value=0) } } }
    }
  }

  Let(name=eventTextOf) {
    Fn(params=eventNode) {
      Block { Return { Call(target=attrString) { Var(name=eventNode) Lit(value="text") Lit(value=0) } } }
    }
  }

  Let(name=eventXOf) {
    Fn(params=eventNode) {
      Block { Return { Call(target=attrInt) { Var(name=eventNode) Lit(value="x") Lit(value=0) } } }
    }
  }

  Let(name=eventYOf) {
    Fn(params=eventNode) {
      Block { Return { Call(target=attrInt) { Var(name=eventNode) Lit(value="y") Lit(value=0) } } }
    }
  }

  Let(name=eventWidthOf) {
    Fn(params=eventNode) {
      Block { Return { Call(target=attrInt) { Var(name=eventNode) Lit(value="width") Lit(value=0) } } }
    }
  }

  Let(name=eventHeightOf) {
    Fn(params=eventNode) {
      Block { Return { Call(target=attrInt) { Var(name=eventNode) Lit(value="height") Lit(value=0) } } }
    }
  }

  Let(name=eventIsKeyboardLike) {
    Fn(params=eventNode) {
      Block {
        Let(name=eventType) { Call(target=eventTypeOf) { Var(name=eventNode) } }
        If {
          Eq { Var(name=eventType) Lit(value="key") }
          Block { Return { Lit(value=true) } }
          Block {
            If {
              Eq { Var(name=eventType) Lit(value="text") }
              Block { Return { Lit(value=true) } }
              Block {
                If {
                  Eq { Var(name=eventType) Lit(value="textinput") }
                  Block { Return { Lit(value=true) } }
                  Block {
                    If {
                      Eq { Var(name=eventType) Lit(value="input") }
                      Block { Return { Lit(value=true) } }
                      Block {
                        If {
                          Eq { Var(name=eventType) Lit(value="char") }
                          Block { Return { Lit(value=true) } }
                          Block {
                            If {
                              Eq { Var(name=eventType) Lit(value="keydown") }
                              Block { Return { Lit(value=true) } }
                              Block {
                                If {
                                  Eq { Var(name=eventType) Lit(value="key_down") }
                                  Block { Return { Lit(value=true) } }
                                  Block {
                                    If {
                                      Eq { Var(name=eventType) Lit(value="keypress") }
                                      Block { Return { Lit(value=true) } }
                                      Block { Return { Lit(value=false) } }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=eventInputText) {
    Fn(params=eventNode) {
      Block {
        Let(name=textValue) { Call(target=eventTextOf) { Var(name=eventNode) } }
        If {
          Eq { Var(name=textValue) Lit(value="") }
          Block { Return { Call(target=keyToText) { Call(target=eventKeyOf) { Var(name=eventNode) } } } }
          Block { Return { Var(name=textValue) } }
        }
      }
    }
  }

  Let(name=eventControlKey) {
    Fn(params=eventNode) {
      Block {
        Let(name=keyName) { Call(target=controlKeyName) { Call(target=eventKeyOf) { Var(name=eventNode) } } }
        If {
          Eq { Var(name=keyName) Lit(value="") }
          Block { Return { Call(target=controlKeyName) { Call(target=eventTextOf) { Var(name=eventNode) } } } }
          Block { Return { Var(name=keyName) } }
        }
      }
    }
  }

  Let(name=eventIsNone) {
    Fn(params=eventNode) {
      Block { Return { Eq { Call(target=eventTypeOf) { Var(name=eventNode) } Lit(value="none") } } }
    }
  }

  Let(name=eventIsClosed) {
    Fn(params=eventNode) {
      Block { Return { Eq { Call(target=eventTypeOf) { Var(name=eventNode) } Lit(value="closed") } } }
    }
  }
}
