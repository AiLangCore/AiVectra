Program {
  Import(package="aivectra" path="src/AiVectra/src/app.aos")
  Import(package="aivectra" path="src/AiVectra/src/lib.aos")
  Import(package="std-app" path="src/app/event.aos")
  Import(package="std-app" path="src/app/next.aos")
  Export(name=start)

  Let(name=app) {
    Call(target=aivectraApp) {
      Lit(value="{{projectName}}")
      Lit(value="init")
      Lit(value="update")
      Lit(value="render")
    }
  }

  Let(name=start) {
    Fn(params=args) {
      Block {
        Return { Call(target=aivectraRun) { Var(name=app) Var(name=args) } }
      }
    }
  }

  Let(name=init) {
    Fn(params=args) {
      Block {
        Return {
          Map {
            Field(key="message") { Lit(value="Hello from {{projectName}}") }
            Field(key="settingsOpen") { Lit(value=false) }
          }
        }
      }
    }
  }

  Let(name=update) {
    Fn(params=state,event) {
      Block {
        If {
          Eq { Call(target=eventType) { Var(name=event) } Lit(value="UiEvent") }
          Block {
            Let(name=rawEvent) { Call(target=mapGetNodeOr) { Var(name=event) Lit(value="event") Map { } } }
            If {
              Eq { Call(target=eventTypeOf) { Var(name=rawEvent) } Lit(value="command") }
              Block {
                If {
                  Eq { Call(target=eventKeyOf) { Var(name=rawEvent) } Lit(value="settings") }
                  Block { Return { Call(target=next) { Call(target=mapSet) { Var(name=state) Lit(value="settingsOpen") Lit(value=true) } } } }
                  Block { Lit(value=0) }
                }
              }
              Block { Lit(value=0) }
            }
          }
          Block { Lit(value=0) }
        }
        Return { Call(target=next) { Var(name=state) } }
      }
    }
  }

  Let(name=render) {
    Fn(params=handle,state) {
      Block {
        Call(target=sys.ui.beginFrame) { Var(name=handle) }
        Call(target=rect) { Var(name=handle) }
        Call(target=text) { Var(name=handle) Call(target=mapGetStringOr) { Var(name=state) Lit(value="message") Lit(value="") } }
        If {
          Eq { Call(target=mapGetBoolOr) { Var(name=state) Lit(value="settingsOpen") Lit(value=false) } Lit(value=true) }
          Block {
            Call(target=sys.ui.drawRect) { Var(name=handle) Lit(value=180) Lit(value=140) Lit(value=320) Lit(value=120) Lit(value="#0f172a") }
            Call(target=sys.ui.drawText) { Var(name=handle) Lit(value=204) Lit(value=164) Lit(value="Settings") Lit(value="#ffffff") Lit(value=22) }
            Call(target=sys.ui.drawText) { Var(name=handle) Lit(value=204) Lit(value=202) Lit(value="Add app preferences here.") Lit(value="#cbd5e1") Lit(value=14) }
            Lit(value=0)
          }
          Block { Lit(value=0) }
        }
        Call(target=sys.ui.endFrame) { Var(name=handle) }
        Call(target=sys.ui.present) { Var(name=handle) }
        Return { Lit(value=0) }
      }
    }
  }
}
