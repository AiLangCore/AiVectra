Program#p1 {
  Import#i0(package="aivectra" path="src/AiVectra/src/app.aos")
  Import#i1(package="aivectra" path="src/AiVectra/src/lib.aos")
  Export#e1(name=start)

  Let#app1(name=app) {
    Call#app2(target=aivectraApp) {
      Lit#app3(value="{{projectName}}")
      Lit#app4(value="init")
      Lit#app5(value="update")
      Lit#app6(value="render")
    }
  }

  Let#l1(name=start) {
    Fn#f1(params=args) {
      Block#b1 {
        Let#h1(name=handle) { Call#c1(target=window) { Lit#title(value="{{projectName}}") } }
        Call#c2(target=rect) { Var#v1(name=handle) }
        Call#c3(target=text) { Var#v2(name=handle) Lit#msg(value="Hello from {{projectName}}") }
        Call#c4(target=sys.ui.waitFrame) { Var#v3(name=handle) }
        Return#r1 { Lit#ok(value=0) }
      }
    }
  }
}
