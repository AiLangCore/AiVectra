Program {
  Import(package="aivectra" path="src/AiVectra/src/lib.aos")

  Let(name=renderView) {
    Fn(params=handle,message) {
      Block {
        Call(target=rect) { Var(name=handle) }
        Call(target=text) { Var(name=handle) Var(name=message) }
        Return { Lit(value=0) }
      }
    }
  }
}
